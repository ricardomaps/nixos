
(defcfg
;; Global settings
  input  (device-file "/dev/input/by-path/platform-i8042-serio-0-event-kbd")
  output (uinput-sink "My KMonad Keyboard")
  fallthrough true
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    ret
  caps a    s    d    f    g    h    j    k    l    ;    '    \
  lsft z    x    c    v    b    n    m    ,    .    /  
  lctl fn lmet lalt           spc               ralt    rctl
)

(deflayer default
  @col f1   f2   f3   f4   f5   f6   f7   f8   f9   f10 f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    ret
  @ext a    s    d    f    g    h    j    k    l    ;    '    \
  lsft z    x    c    v    b    n    m    ,    .    /   
  lctl fn  lmet lalt           spc              @ssft    rctl
)

;; Colemak Mod-DH main layer
(deflayer colemak-dh
  @def  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv   1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab   q    w    f    p    b    j    l    u    y    ;    [    ]    ret
  @ext  a    r    s    t    g    m    n    e    i    o    '    \
  lsft  x    c    d    v    z    k    h    ,    .    /
  lctl  fn lmet lalt           spc            @ssft   rmet
)

(defalias ext (tap-next esc lctl))
(defalias ssft (sticky-key 500 rsft))
(defalias col (layer-switch colemak-dh))
(defalias def (layer-switch default))
